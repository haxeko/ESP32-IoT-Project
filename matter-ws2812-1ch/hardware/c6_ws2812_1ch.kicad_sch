	(text "SW1 (GPIO9 = BOOT): bam nhanh = bat/tat hoac vao che do ket noi; giu >5 s = factory reset.\nGiu SW1 trong luc cap nguon = vao che do nap ROM." (exclude_from_sim no) (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6995c7c0-b16c-517e-8ca7-23e3c2294bbe"))
	(text "SW2 = C&K PCM13SMTR, chan 3 la chan chung (noi GND). Nac 1 noi 1-3, nac 2 noi 2-3, nac 3 noi 3-4.\nFirmware: IO21/IO22/IO23 la input, bat pull-up noi; chan nao doc 0 -> chia day LED thanh 1/2/3 doan,\nmoi doan la mot endpoint Matter. Khong chan nao doc 0 (dang gat giua 2 nac) -> giu gia tri cu." (exclude_from_sim no) (at 147.32 259.08 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a72aa4fd-0d5f-563a-9786-b3c4aecd2de0"))
	(text "Q1 chong cam nguoc. Dong toi da 5 A. TVS D3 kep xung qua ap.\nKhong co cau chi: dung nguon co bao ve ngan mach." (exclude_from_sim no) (at 20.32 78.74 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8a7230b0-5c41-53c7-adb1-99eb7c981eef"))
	(text "DATA 5V: WS2812B (5V) va WS2811 (12V) deu nhan muc 5V." (exclude_from_sim no) (at 302.26 166.37 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8e157fe8-78ae-5e39-8417-8af6247eb59d"))
	(text "IO18: GPIO thuong, pull-up yeu chi trong luc reset.\nMuc 3,3 V, khong chiu 5 V." (exclude_from_sim no) (at 20.32 228.6 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "eff7f425-7ee8-5986-9313-014f463da333"))
	(text "IO0-IO7, IO15, IO19, IO20:\nde trong. Anten module nho ra\nngoai mep board (khong de dong)." (exclude_from_sim no) (at 147.32 152.4 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "20b14844-744b-557d-acf3-54ac87dadcb2"))
