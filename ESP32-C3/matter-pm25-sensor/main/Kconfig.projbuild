menu "Device Information"

    config DEVICE_VENDOR_NAME
        string "Manufacturer (Basic Information VendorName)"
        default "Haxeko"

    config DEVICE_PRODUCT_NAME
        string "Model (Basic Information ProductName)"
        default "PM5003"

    config DEVICE_DISPLAY_NAME
        string "Device name (Basic Information NodeLabel / ProductLabel)"
        default "Air Quality Sensor"
        help
            Default name that controllers show when the device is added.
            Max 32 characters. It can be renamed later in the app.

    config DEVICE_HARDWARE_VERSION_STRING
        string "Hardware (Basic Information HardwareVersionString)"
        default "ESP32C3-SDS011" if PM_SENSOR_MODEL_SDS011
        default "ESP32C3-PMS5003"
        help
            Hardware description that controllers show for the device, e.g.
            "Hardware" in Home Assistant. Max 64 characters.

endmenu

menu "PM2.5 Sensor Configuration"

    choice PM_SENSOR_MODEL
        prompt "PM sensor model"
        default PM_SENSOR_MODEL_PMS
        help
            UART particulate matter sensor connected to the ESP32-C3.

        config PM_SENSOR_MODEL_PMS
            bool "Plantower PMS5003 / PMS7003 / PMSA003"

        config PM_SENSOR_MODEL_SDS011
            bool "Nova Fitness SDS011 / SDS021"
    endchoice

    config PM_SENSOR_UART_RX_PIN
        int "UART RX pin (connect to sensor TX)"
        default 6
        help
            GPIO6 on the PCB: connector J2B pin 3, the sensor TX.

    config PM_SENSOR_UART_TX_PIN
        int "UART TX pin (connect to sensor RX)"
        default 7
        help
            GPIO7 on the PCB: connector J2B pin 4, the sensor RX.

    config PM_SENSOR_PMS_PERIOD_SEC
        int "PMS measurement period (seconds, 0 = continuous)"
        depends on PM_SENSOR_MODEL_PMS
        range 0 3600
        default 300
        help
            When non-zero, the PMS sensor sleeps (fan and laser off) between
            measurements: it is woken up, warmed up for 30 seconds, sampled
            for 5 seconds and put back to sleep. This greatly extends its life.
            Values below 60 are treated as 60.

    config PM_SENSOR_REPORT_INTERVAL_SEC
        int "Report interval in continuous mode (seconds)"
        range 1 3600
        default 10
        help
            In continuous mode, samples received from the sensor are averaged
            over this interval and then published.

    config PM_SENSOR_SDS011_WORK_PERIOD_MIN
        int "SDS011 working period (minutes, 0 = continuous)"
        depends on PM_SENSOR_MODEL_SDS011
        range 0 30
        default 0
        help
            In periodic mode the SDS011 sleeps and wakes up every N minutes,
            runs the fan for 30 seconds and sends one measurement. This
            greatly extends the life of the laser and fan.

endmenu

menu "Local Display and Indicators"

    config OLED_SDA_PIN
        int "OLED I2C SDA pin"
        default 4

    config OLED_SCL_PIN
        int "OLED I2C SCL pin"
        default 5

    config OLED_I2C_ADDRESS
        hex "OLED I2C address"
        default 0x3C

    choice OLED_CONTROLLER
        prompt "OLED controller"
        default OLED_CONTROLLER_SSD1306
        help
            0.96" modules are usually SSD1306, 1.3" modules SH1106. With the
            wrong one, the image is shifted by 2 pixels and one edge shows
            garbage columns.

        config OLED_CONTROLLER_SSD1306
            bool "SSD1306 (0.96\", the PCB)"

        config OLED_CONTROLLER_SH1106
            bool "SH1106 (1.3\")"
    endchoice

    config OLED_ROTATE_180
        bool "Rotate OLED 180 degrees"
        default n
        help
            Off: upright with the module's pin header on top, as on the PCB.
            On: for a module mounted with the pin header at the bottom.

    config STATUS_LED_GPIO
        int "WS2812 data pin"
        default 3

    config STATUS_LED_COUNT
        int "Number of WS2812 LEDs"
        range 1 64
        default 6

    config STATUS_LED_BRIGHTNESS
        int "WS2812 brightness (%)"
        range 1 100
        default 50

    config DISPLAY_BUTTON_GPIO
        int "Display on/off button GPIO (-1 = no button)"
        range -1 21
        default -1
        help
            Optional push button between this GPIO and GND (the internal
            pull-up is used). Each press turns the OLED off when it is on, and
            on when it is off. The choice is saved and applies again after a
            restart. The OLED is still on during start-up (until the first
            measurement + 5 s) and during a factory reset. Without a button
            (-1, the PCB has none) the OLED stays on.

            Free on an ESP32-C3 with the PCB wiring: GPIO0, 1, 10, 20. Do not
            use a strapping pin (GPIO2, 8, 9), the flash pins (GPIO11 to 17),
            the USB pins (GPIO18, 19) or GPIO21 (boot log output).

endmenu

menu "Factory Reset Button"

    config FACTORY_RESET_BUTTON_GPIO
        int "Button GPIO (-1 = no button)"
        range -1 21
        default -1
        help
            Push button between this GPIO and GND (the internal pull-up is
            used). Hold it for 5 seconds, until the OLED says to release it,
            then release it: the device erases its Wi-Fi and Matter pairing
            and restarts, ready to be paired again. Releasing it earlier
            cancels.

            The PCB has no factory reset button (-1): power the device on 5
            times in a row instead, each time for less than 10 seconds.

            Free on an ESP32-C3 with the PCB wiring: GPIO0, 1, 10, 20. Do not
            use a strapping pin (GPIO2, 8, 9), the flash pins (GPIO11 to 17),
            the USB pins (GPIO18, 19) or GPIO21 (boot log output).

endmenu
