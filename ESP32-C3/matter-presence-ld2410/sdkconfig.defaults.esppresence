# Experimental ESP32 presence engine (branch claude/c3-wroom-esp-presence, README "Bộ xử lý hiện diện trên ESP32"),
# for the ESP32-C3-WROOM-02-N4 board. Applied after sdkconfig.defaults and sdkconfig.defaults.wroom_n4:
#   idf.py -B build-esppresence -D IDF_TARGET=esp32c3 -D SDKCONFIG=sdkconfig.esppresence \
#     -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.wroom_n4;sdkconfig.defaults.esppresence" build
# Manufacturer, Model (ProductName), serial number, version string (1.0.<count>) and commissioning name as the stable
# firmware; no chip temperature entity (endpoint 5), unlike sdkconfig.defaults.wroom_n4.
CONFIG_PRESENCE_CHIP_TEMPERATURE=n
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=5
CONFIG_PRESENCE_ESP_ENGINE=y
# Hold time = the absence countdown of the engine: empty after 60 s without a hold signal
CONFIG_PRESENCE_HOLD_TIME_SEC=60
# Empty room learning: the ESP32 records the room for 120 s and sets every radar threshold from the average and the
# highest energy of its channel (at least 75 % of the factory threshold); the radar's own detection is not used
CONFIG_LD2410_LEARN_DURATION_SEC=120
