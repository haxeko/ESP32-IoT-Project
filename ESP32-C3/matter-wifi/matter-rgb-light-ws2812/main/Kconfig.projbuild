menu "Device Information"

    config DEVICE_VENDOR_NAME
        string "Manufacturer (Basic Information VendorName)"
        default "Haxeko"
        help
            Shown as Manufacturer by Apple Home, Google Home, Home Assistant... Max 32 characters.

    config DEVICE_PRODUCT_NAME
        string "Model (Basic Information ProductName)"
        default "Vibe Light"
        help
            Shown as Model. Max 32 characters.

    config DEVICE_DISPLAY_NAME
        string "Device name (Basic Information NodeLabel / ProductLabel)"
        default "Vibe Light"
        help
            Default name that controllers show when the device is added.
            Max 32 characters. It can be renamed later in the app.

endmenu

menu "WS2812 RGB Light"

    config LED_GPIO
        int "WS2812 data GPIO"
        range 0 21
        default 4
        help
            GPIO connected to DIN of the first WS2812.

    config LED_COUNT
        int "Number of WS2812 LEDs"
        range 1 1024
        default 30

    config LED_FIXED_BRIGHTNESS_PERCENT
        int "Fixed intensity of every lit LED (%)"
        range 1 100
        default 30
        help
            Each lit LED always shines at this intensity. The brightness set from
            Matter (0-100 %) does not dim the LEDs: it chooses how many LEDs are lit
            (100 % = all LEDs, 50 % = half of them, ...).

    config LED_FILL_REVERSE
        bool "Light LEDs from the end of the strip"
        default n
        help
            By default LEDs are lit starting at the first LED (next to DIN).

endmenu

menu "Button"

    config APP_BUTTON_GPIO
        int "Button GPIO (active low)"
        range -1 21
        default 9
        help
            Short press: toggle the light. Hold 5 s, then release: factory reset.
            GPIO9 is the BOOT button on ESP32-C3 boards (SuperMini, DevKitM-1). -1 disables the button.

endmenu

menu "Wi-Fi Power Save"

    config WIFI_NO_POWER_SAVE
        bool "Mains powered: no Wi-Fi power save once commissioned"
        default y
        help
            ESP-IDF starts Wi-Fi in modem sleep: the radio sleeps between the router's DTIM beacons, so
            commands and mDNS queries from controllers wait for the next beacon. On mains power this is
            not needed: once commissioning is over and Bluetooth is off, power save is turned off
            (WIFI_PS_NONE) and the radio stays on, for a few tens of mA more. While Bluetooth runs
            (BLE commissioning), Wi-Fi stays in modem sleep, which ESP-IDF requires when both share
            the radio. n: keep the ESP-IDF default (modem sleep) all the time.

endmenu
