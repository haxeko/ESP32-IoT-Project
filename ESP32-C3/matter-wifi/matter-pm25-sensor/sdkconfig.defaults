CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

#enable BT
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

#disable BT connection reattempt
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

#enable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

#enable lwIP route hooks
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# disable softap by default
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

CONFIG_ENABLE_WIFI_AP=n

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# Increase LwIP IPv6 address number to 6 (MAX_FABRIC + 1)
# unique local addresses for fabrics(MAX_FABRIC), a link local address(1)
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Enable OTA Requestor
CONFIG_ENABLE_OTA_REQUESTOR=y

# GPIO20/GPIO21 are the default UART0 console pins on ESP32-C3. They are used
# for the PM sensor here (UART1) and UART0 drives the LD2410, so move the log
# console to the built-in USB-Serial-JTAG.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# PM sensor
CONFIG_PM_SENSOR_MODEL_PMS=y
CONFIG_PM_SENSOR_UART_RX_PIN=20
CONFIG_PM_SENSOR_UART_TX_PIN=21

# RAM optimizations (esp-matter docs/en/optimizations.rst). The OLED, LEDs and
# radar add tasks and buffers; keep enough heap for BLE + Wi-Fi + CASE during
# commissioning. On ESP32-C3 IRAM and DRAM share the same SRAM, so moving the
# Wi-Fi hot paths out of IRAM directly increases the heap.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=4
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# Manufacturer / Model / Hardware come from main/device_info.cpp
CONFIG_CUSTOM_DEVICE_INSTANCE_INFO_PROVIDER=y

# Bluetooth name while waiting for commissioning: "AirQuality-<discriminator>"
# (at most 16 characters in total)
CONFIG_BLE_DEVICE_NAME_PREFIX="AirQuality-"

# Name and device type in commissionable discovery (DNS-SD "DN" and "DT"),
# shown by controllers before pairing. 44 = 0x002C Air Quality Sensor.
CONFIG_CHIP_PROJECT_CONFIG="main/chip_project_config.h"
CONFIG_ENABLE_COMMISSIONABLE_DEVICE_TYPE=y
CONFIG_DEVICE_TYPE=44

# Task watchdog: restart the device when the Matter thread or one of the
# application tasks (PM sensor, radar, local UI) stops running for 30 s,
# instead of staying stuck (they feed it, see app_main.cpp and the drivers).
# Rollback: CONFIG_ESP_TASK_WDT_PANIC=n only prints a warning.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Interaction Model message pretty-printing only feeds debug logs that are not
# compiled in: turn it off (less flash and CPU per request, same behavior).
CONFIG_CHIP_CONFIG_IM_PRETTY_PRINT=n
