CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

#enable BT (Matter commissioning over BLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

#disable BT connection reattempt
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# Log and Matter console on the built-in USB port (ESP32-C3 SuperMini has no USB-UART chip)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Manufacturer / Model / serial number come from main/device_info.cpp
CONFIG_CUSTOM_DEVICE_INSTANCE_INFO_PROVIDER=y

# Bluetooth name while waiting for commissioning: "VibeLift-<discriminator>" (at most 16 characters)
CONFIG_BLE_DEVICE_NAME_PREFIX="VibeLift-"

# BLE is only used for commissioning, as a peripheral (esp-matter docs/en/optimizations.rst)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# WS2812 via RMT without DMA: keep refilling the RMT buffer while the flash cache is disabled
# (NVS writes), otherwise the frame on the strip can be corrupted (wrong colors / flicker)
CONFIG_RMT_TX_ISR_CACHE_SAFE=y

# Step motor: the 20 kHz timer interrupt (main/stepper.c, in IRAM) keeps running while the flash cache is disabled
# (NVS writes), otherwise steps stop for a few ms and the motion jerks
CONFIG_GPTIMER_ISR_CACHE_SAFE=y

#enable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# Enable chip shell
CONFIG_ENABLE_CHIP_SHELL=y

#enable lwIP route hooks
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Only a few dynamic endpoints are needed
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2

# disable softap by default
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Enable OTA Requestor
CONFIG_ENABLE_OTA_REQUESTOR=y

# Task watchdog: restart the device when the Matter thread (fed every 5 s, see main/app_health.cpp) or the idle
# task stops running for 30 s, instead of leaving the light unresponsive until it is unplugged.
# Rollback: CONFIG_ESP_TASK_WDT_PANIC=n only prints a warning.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Increase LwIP IPv6 address number to 6 (MAX_FABRIC + 1)
# unique local addresses for fabrics(MAX_FABRIC), a link local address(1)
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Exclude unused clusters to optimize flash and memory usage
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIONS_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AIR_QUALITY_CLUSTER=n
