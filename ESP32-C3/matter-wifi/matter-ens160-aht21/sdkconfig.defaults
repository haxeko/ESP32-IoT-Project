# ESP32-C3 SuperMini (flash 4 MB), Matter over Wi-Fi (station), commissioning over BLE. ENS160 + AHT21 module on I2C
# (pins: menuconfig -> Board).
# sdkconfig.defaults only applies to a new sdkconfig: after changing this file, delete sdkconfig (or run
# idf.py set-target esp32c3), an existing sdkconfig keeps its old values.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table: two 1.9 MB app partitions for OTA updates. An OTA update cannot change it: keep it.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# BLE (NimBLE), only used for commissioning and released afterwards (CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING): one
# connection from the phone as peripheral, no BLE pairing (Matter secures the session itself, PASE), legacy
# advertising and 1M PHY only, small buffer pools. Less RAM while BLE and Wi-Fi run together during commissioning
# ("BLE Optimizations" of the esp-matter RAM guide, docs/en/optimizations.rst).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_WHITELIST_SIZE=1
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=10
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=100
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=320
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=5
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=5
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=3

# Wi-Fi station, Matter over Wi-Fi: the ESP32-C3 has no 802.15.4 radio for Thread. The phone sends the SSID and
# password over BLE; the Matter SDK joins and rejoins the network itself. Wi-Fi modem sleep stays on (ESP-IDF
# default): the chip warms the board less, which matters next to a temperature sensor.
CONFIG_ENABLE_WIFI_STATION=y
CONFIG_OPENTHREAD_ENABLED=n
# No SoftAP (commissioning is over BLE only)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
# Wi-Fi code in flash instead of IRAM: on the ESP32-C3, IRAM and DRAM share the same SRAM, so this leaves more
# heap. Costs a little Wi-Fi throughput, which Matter does not need.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Security modes the Matter SDK never uses: it only sets the SSID and passphrase of the network
# (WPA/WPA2/WPA3 Personal), so no enterprise (802.1X/EAP) and no OWE. WPA3 SAE stays.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
# IPv6 addresses from the router advertisements (SLAAC): link-local + up to 5 SLAAC addresses, as in the
# esp-matter Wi-Fi examples
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# The SuperMini has no USB-UART chip: logs on the built-in USB-Serial-JTAG of the USB-C port (GPIO18/GPIO19).
# No Matter console (about 10 KB more heap, esp-matter RAM guide): turn CONFIG_ENABLE_CHIP_SHELL back on in
# menuconfig to debug.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ENABLE_CHIP_SHELL=n

# Matter. Test vendor ID 0xFFF1 (default) with an own product ID, 0x8002, so that controllers and OTA images never
# mix this device up with the other firmwares of the repo (0x8000, 0x8001). The SDK test DAC, PAI and Certification
# Declaration cover 0xFFF1/0x8002.
CONFIG_DEVICE_PRODUCT_ID=0x8002
# Root, Temperature Sensor, Humidity Sensor and Air Quality Sensor endpoints
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=4
# Manufacturer / Model / Serial number come from main/device_info.cpp
CONFIG_CUSTOM_DEVICE_INSTANCE_INFO_PROVIDER=y
# Bluetooth (GAP) name while waiting for commissioning when CONFIG_DEVICE_NAME_PREFIX is empty:
# "ENS160-<discriminator>". By default the device name "ENS160-<last 4 serial characters>" is used instead.
CONFIG_BLE_DEVICE_NAME_PREFIX="ENS160-"
# Name and device type in commissionable discovery (DNS-SD "DN" and "DT"), shown by controllers before pairing.
# 770 = 0x0302 Temperature Sensor.
CONFIG_CHIP_PROJECT_CONFIG="main/chip_project_config.h"
CONFIG_ENABLE_COMMISSIONABLE_DEVICE_TYPE=y
CONFIG_DEVICE_TYPE=770
# OTA Requestor, and matter_ens160_aht21-ota.bin in the build dir: the app image with the Matter OTA header (VID/PID
# from the config, version = PROJECT_VER_NUMBER/PROJECT_VER), the file a controller (Home Assistant Matter Server)
# serves
CONFIG_ENABLE_OTA_REQUESTOR=y
CONFIG_CHIP_OTA_IMAGE_BUILD=y
# Matter event history: critical events (start-up, boot reason) are rare and there are no debug events
CONFIG_EVENT_LOGGING_CRIT_BUFFER_SIZE=1024
CONFIG_EVENT_LOGGING_DEBUG_BUFFER_SIZE=256

# Matter clusters no endpoint of this device has: less flash. The device keeps 25 clusters: those of its endpoints
# (Access Control, Administrator Commissioning, Air Quality, Basic Information, Carbon Dioxide and TVOC
# Concentration Measurement, Descriptor, General Commissioning, General Diagnostics, Group Key Management, Identify,
# Network Commissioning, Operational Credentials, OTA Software Update Provider/Requestor, Relative Humidity
# Measurement, Temperature Measurement, Wi-Fi Network Diagnostics), plus Thread Network Diagnostics, Scenes,
# Binding, Groups, On/Off, Level Control and Color Control (code the SDK builds anyway).
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIONS_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AMBIENT_CONTEXT_SENSING_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_BASIC_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_LAUNCHER_CLUSTER=n
CONFIG_SUPPORT_AUDIO_OUTPUT_CLUSTER=n
CONFIG_SUPPORT_BOOLEAN_STATE_CLUSTER=n
CONFIG_SUPPORT_BOOLEAN_STATE_CONFIGURATION_CLUSTER=n
CONFIG_SUPPORT_BRIDGED_DEVICE_BASIC_INFORMATION_CLUSTER=n
CONFIG_SUPPORT_CAMERA_AV_SETTINGS_USER_LEVEL_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_CAMERA_AV_STREAM_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_CARBON_MONOXIDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_CHANNEL_CLUSTER=n
CONFIG_SUPPORT_CHIME_CLUSTER=n
CONFIG_SUPPORT_CLOSURE_CONTROL_CLUSTER=n
CONFIG_SUPPORT_CLOSURE_DIMENSION_CLUSTER=n
CONFIG_SUPPORT_COMMISSIONER_CONTROL_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_METERING_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_PRICE_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_TARIFF_CLUSTER=n
CONFIG_SUPPORT_CONTENT_APP_OBSERVER_CLUSTER=n
CONFIG_SUPPORT_CONTENT_CONTROL_CLUSTER=n
CONFIG_SUPPORT_CONTENT_LAUNCHER_CLUSTER=n
CONFIG_SUPPORT_DEVICE_ENERGY_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_DEVICE_ENERGY_MANAGEMENT_MODE_CLUSTER=n
