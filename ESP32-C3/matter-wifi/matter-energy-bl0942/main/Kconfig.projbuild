menu "Relay Configuration"

    config RELAY_GPIO
        int "Relay GPIO number"
        range 0 21
        default 5
        help
            GPIO that drives the relay module.

    config RELAY_ACTIVE_LEVEL
        int "Relay active level (1 = active-high, 0 = active-low)"
        range 0 1
        default 1
        help
            Level written to the relay GPIO to turn the relay ON.
            Many cheap optocoupled relay boards are active-low: set 0 for those.

endmenu

menu "BL0942 Power Meter"

    config BL0942_ENABLE
        bool "Enable BL0942 power metering"
        default y
        help
            Read active power / voltage / current / energy from a BL0942 (UART) and
            expose them over Matter (Electrical Power + Energy Measurement).

    config BL0942_UART_PORT
        int "UART port"
        depends on BL0942_ENABLE
        range 0 1
        default 1
        help
            UART0 is normally used for the log console.

    config BL0942_UART_RX_GPIO
        int "ESP32 RX GPIO (connect to BL0942 TX)"
        depends on BL0942_ENABLE
        range 0 21
        default 0

    config BL0942_UART_TX_GPIO
        int "ESP32 TX GPIO (connect to BL0942 RX)"
        depends on BL0942_ENABLE
        range 0 21
        default 1

    config BL0942_UART_BAUD
        int "Baud rate"
        depends on BL0942_ENABLE
        default 9600
        help
            Initial baud rate: 4800 when the BL0942 SCLK_BPS pin is tied low, 9600 when high.
            If the BL0942 does not answer, the driver alternates 9600/4800 and
            re-runs the BL0942 setup (soft reset + MODE) until a valid packet is received.

    config BL0942_ADDRESS
        int "Device address (A1/A2 pins)"
        depends on BL0942_ENABLE
        range 0 3
        default 0

    config BL0942_VOLTAGE_REF
        string "Voltage reference (LSB per V)"
        depends on BL0942_ENABLE
        default "15873.35944"
        help
            V = V_RMS / VOLTAGE_REF. Default matches the common module
            (5 x 390k + 510R divider, 1 mOhm shunt).

    config BL0942_CURRENT_REF
        string "Current reference (LSB per A)"
        depends on BL0942_ENABLE
        default "251213.46469"
        help
            I = I_RMS / CURRENT_REF.

    config BL0942_POWER_REF
        string "Power reference (LSB per W)"
        depends on BL0942_ENABLE
        default "596"
        help
            P = WATT / POWER_REF.

    config BL0942_ENERGY_REF
        string "Energy reference (CF pulses per kWh), 0 = derive from POWER_REF"
        depends on BL0942_ENABLE
        default "0"
        help
            E(kWh) = CF_CNT / ENERGY_REF. "0" uses POWER_REF * 3600000 / 419430.4.

    config BL0942_POWER_CAL_PERMILLE
        int "Power calibration factor (per mille, 1000 = x1.000)"
        depends on BL0942_ENABLE
        default 1000

    config BL0942_VOLTAGE_CAL_PERMILLE
        int "Voltage calibration factor (per mille)"
        depends on BL0942_ENABLE
        default 1000

    config BL0942_CURRENT_CAL_PERMILLE
        int "Current calibration factor (per mille)"
        depends on BL0942_ENABLE
        default 1000

    config BL0942_UPDATE_INTERVAL_MS
        int "Update interval (ms)"
        depends on BL0942_ENABLE
        range 500 10000
        default 2000

endmenu
