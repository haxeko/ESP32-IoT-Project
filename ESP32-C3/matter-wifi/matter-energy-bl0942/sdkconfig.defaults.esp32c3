CONFIG_IDF_TARGET="esp32c3"

# ESP32-C3 board settings
# BOOT button (GPIO9): short press toggles relay, long press (5 s) = factory reset
CONFIG_BSP_BUTTONS_NUM=1
CONFIG_BSP_BUTTON_1_TYPE_GPIO=y
CONFIG_BSP_BUTTON_1_GPIO=9
CONFIG_BSP_BUTTON_1_LEVEL=0
# On-board RGB LED (unused by the app, kept for device_hal)
CONFIG_BSP_LEDS_NUM=1
CONFIG_BSP_LED_TYPE_RGB=y
CONFIG_BSP_LED_RGB_GPIO=8
CONFIG_BSP_LED_RGB_BACKEND_RMT=y

# Relay on GPIO5, active-high
CONFIG_RELAY_GPIO=5
CONFIG_RELAY_ACTIVE_LEVEL=1

# BL0942 power meter (UART0: BL0942 TX -> GPIO0, BL0942 RX -> GPIO1)
CONFIG_BL0942_ENABLE=y
CONFIG_BL0942_UART_RX_GPIO=0
CONFIG_BL0942_UART_TX_GPIO=1
CONFIG_BL0942_UART_BAUD=9600
# Same as ESPHome with "logger: baud_rate: 0": the BL0942 gets UART0
CONFIG_BL0942_UART_PORT=0

# Log console moves to UART1, still on the usual pins (TX GPIO21, RX GPIO20),
# plus the USB-Serial-JTAG secondary console
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_1=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=21
CONFIG_ESP_CONSOLE_UART_RX_GPIO=20
