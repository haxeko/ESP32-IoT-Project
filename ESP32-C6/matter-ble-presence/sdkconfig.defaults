# ESP32-C6, flash 4 MB or more (ESP32-C6-DevKitM-1 N4: 4 MB; ESP32-C6-DevKitC-1 N8: 8 MB, the first 4 MB are used).
# Matter over Thread (end device) with five Occupancy Sensor endpoints, BLE passive scanning of iBeacons, and a
# Wi-Fi SoftAP only in the CONFIG mode. After changing this file run idf.py set-target esp32c6 (or delete sdkconfig):
# an existing sdkconfig keeps its old values.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Own partition table (partitions.csv): one factory app (no OTA in this version), "nvs" for Matter / Thread / PHY,
# "app_cfg" for the beacon configuration only. Table at 0xC000 as in the esp-matter examples.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# ---------------------------------------------------------------------------------------------------------------------
# BLE: NimBLE, one host shared by Matter (peripheral: commissioning advertisement and connection) and the beacon
# scanner (observer). Central role off (no connection to the beacons). Legacy advertising and scanning, as the
# esp-matter C6 Thread examples (sdkconfig.defaults.c6_thread of examples/light).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_EXT_ADV=n
CONFIG_BT_NIMBLE_HCI_EVT_BUF_SIZE=70
# Keep BLE after commissioning: by default the SDK shuts NimBLE down and releases its memory once commissioned
# (FAQ A1.16), which would stop the scanner for good.
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n
# Duplicate filtering is off in every scan this firmware starts (filter_duplicates = 0), so each advertisement is
# reported. Should a scan ever be started with filtering on, the controller would report an address once and then
# never again while scanning (refresh period 0 = never): refresh the list every second instead.
CONFIG_BT_LE_SCAN_DUPL_CACHE_REFRESH_PERIOD=1

# ---------------------------------------------------------------------------------------------------------------------
# Thread: minimal Thread device (MTD) build. An MTD has no router code at all, so the device can never become a
# Thread router or leader: BLE scanning next to a router is "X, not supported" in the ESP-IDF coexistence table of
# the ESP32-C6, next to an end device "C1, supported but unstable". The device type is set to Minimal End Device
# (receiver on when idle, mains powered, no polling delay); see matter_device.cpp.
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_MTD=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
# OpenThread CLI in the Matter console ("matter esp ot_cli state", "... counters mac") to measure the coexistence
CONFIG_OPENTHREAD_CLI=y
# Thread assigns the addresses: no SLAAC from router advertisements
CONFIG_LWIP_IPV6_AUTOCONFIG=n
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y
# DNS-SD over SRP on Thread instead of mDNS
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_ENABLE_EXTENDED_DISCOVERY=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Radio coexistence (BLE + 802.15.4 in NORMAL, BLE + Wi-Fi in CONFIG): arbitration by software, required by the
# coexistence guide of ESP-IDF
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# ---------------------------------------------------------------------------------------------------------------------
# Wi-Fi: no Wi-Fi for Matter (Thread only). The Wi-Fi driver is linked for the SoftAP of the CONFIG mode and is
# started only in that mode.
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# The SoftAP settings are not kept in flash: no Wi-Fi write to the "nvs" partition of Matter / Thread
CONFIG_ESP_WIFI_NVS_ENABLED=n
# Wi-Fi code in flash instead of IRAM (the C6 shares one SRAM for code and data): more heap, the configuration
# page does not need throughput
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# Configuration web server: phones send long headers (cookies, Accept-Language)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# cJSON recurses once per nesting level, on the stack of the web server task: with the default limit (1000) a
# body of a few hundred "[" overflows that stack and resets the device. The API nests 3 levels deep.
CONFIG_CJSON_NESTING_LIMIT=16

# ---------------------------------------------------------------------------------------------------------------------
# Matter
# Test vendor 0xFFF1 with an own product ID: the SDK example DAC, PAI and Certification Declaration cover
# 0xFFF1/0x8000-0x801F. 0x8002 is not used by the other firmware of this repository (0x8000 H2, 0x8001 C3).
# Development credentials only, see README.
CONFIG_DEVICE_VENDOR_ID=0xFFF1
CONFIG_DEVICE_PRODUCT_ID=0x8002
# Root node and five Occupancy Sensor endpoints (endpoint ids 0-5, fixed by the creation order)
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=6
CONFIG_CHIP_PROJECT_CONFIG="main/chip_project_config.h"
# Device type in commissionable discovery (DNS-SD "DT"): 263 = 0x0107 Occupancy Sensor
CONFIG_ENABLE_COMMISSIONABLE_DEVICE_TYPE=y
CONFIG_DEVICE_TYPE=263
CONFIG_BLE_DEVICE_NAME_PREFIX="Presence-"
# No OTA in this version
CONFIG_ENABLE_OTA_REQUESTOR=n
# Matter console on the serial port: factory reset ("matter esp factoryreset"), diagnostics, OpenThread CLI
CONFIG_ENABLE_CHIP_SHELL=y
# TC_RR_1_1 requires MaxGroupKeysPerFabric >= 4
CONFIG_MAX_GROUP_KEYS_PER_FABRIC=4

# Clusters no endpoint of this device has: less flash. Kept: the root node clusters, Identify, Occupancy Sensing,
# Thread Network Diagnostics, and Binding, Groups, Scenes, On/Off, Level and Color Control (code the SDK builds
# anyway). Generated from components/esp_matter/utils/cluster_select/Kconfig.in of esp-matter v1.6.1.
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIONS_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AIR_QUALITY_CLUSTER=n
CONFIG_SUPPORT_AMBIENT_CONTEXT_SENSING_CLUSTER=n
