# Settings of every board (ESP32-C3 and ESP32-H2). ESP-IDF then loads the settings of the chip,
# sdkconfig.defaults.esp32c3 (Matter over Wi-Fi) or sdkconfig.defaults.esp32h2 (Matter over Thread), and tools/build.sh
# adds the file of the board, boards/<board>.defaults (pins, LED, button, console). An existing sdkconfig keeps its
# old values: delete build/<board> after changing these files.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table of the ESP32-H2 firmware and of the ESP32-C3 firmware 1.0.132, unchanged so that OTA updates keep
# working (an OTA update cannot change it)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# BLE (NimBLE), only used for commissioning and released afterwards (CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING): one
# connection from the phone as peripheral. The ESP32-C3 trims it further (sdkconfig.defaults.esp32c3).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# lwIP route hooks of the Matter SDK
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Matter. The product ID is the chip's: 0x8001 ESP32-C3, 0x8000 ESP32-H2.
# Root, occupancy sensor, Range, Radar resolution and Radar Bluetooth (Mode Select) endpoints. The chip temperature
# endpoint (CONFIG_PRESENCE_CHIP_TEMPERATURE, ESP32-C3 only, off by default) needs 6.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=5
# Manufacturer / Model / Serial number come from main/device_info.cpp
CONFIG_CUSTOM_DEVICE_INSTANCE_INFO_PROVIDER=y
# Bluetooth (GAP) name while waiting for commissioning when CONFIG_DEVICE_NAME_PREFIX is empty:
# "Presence-<discriminator>". By default the device name "Presence-<last 4 serial characters>" is used instead.
CONFIG_BLE_DEVICE_NAME_PREFIX="Presence-"
# Name and device type in commissionable discovery (DNS-SD "DN" and "DT"), shown by controllers before pairing.
# 263 = 0x0107 Occupancy Sensor.
CONFIG_CHIP_PROJECT_CONFIG="main/chip_project_config.h"
CONFIG_ENABLE_COMMISSIONABLE_DEVICE_TYPE=y
CONFIG_DEVICE_TYPE=263
# OTA Requestor, and matter_presence_sensor-ota.bin in the build dir: the app image with the Matter OTA header
# (VID/PID from the config, version = PROJECT_VER_NUMBER/PROJECT_VER), the file a controller (Home Assistant Matter
# Server) serves
CONFIG_ENABLE_OTA_REQUESTOR=y
CONFIG_CHIP_OTA_IMAGE_BUILD=y

# Empty room learning on every board: the ESP32 records the empty room for 120 s and sets every radar threshold
# from the highest energy and the average of its gate (README, "Học phòng trống")
CONFIG_LD2410_LEARN_PEAK=y
CONFIG_LD2410_LEARN_DURATION_SEC=120

# Matter clusters no endpoint of this device has: less flash. The ones excluded by the earlier ESP32-H2 firmware;
# the ESP32-C3 excludes more (sdkconfig.defaults.esp32c3).
