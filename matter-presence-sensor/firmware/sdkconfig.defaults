# ESP32-C3 SuperMini (flash 4 MB), Matter over Wi-Fi (station), commissioning over BLE.
# After changing this file, run idf.py set-target esp32c3 (or delete sdkconfig): an existing sdkconfig keeps its
# old values.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table of firmware 1.0.132, unchanged so that OTA updates keep working (an OTA update cannot change it)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# BLE (NimBLE), only used for commissioning and released afterwards (CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING): one
# connection from the phone as peripheral, no BLE pairing (Matter secures the session itself, PASE), legacy
# advertising and 1M PHY only, small buffer pools. Less RAM while BLE and Wi-Fi run together during commissioning
# ("BLE Optimizations" of the esp-matter RAM guide, docs/en/optimizations.rst, as in its ESP32-C2 example).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_WHITELIST_SIZE=1
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=10
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=100
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=320
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=5
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=5
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=3

# Wi-Fi station, Matter over Wi-Fi: ESP32-C3 has no 802.15.4 radio for Thread. The phone sends the SSID and
# password over BLE; the Matter SDK joins and rejoins the network itself.
CONFIG_ENABLE_WIFI_STATION=y
CONFIG_OPENTHREAD_ENABLED=n
# No SoftAP (commissioning is over BLE only)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
# Wi-Fi code in flash instead of IRAM: on the ESP32-C3, IRAM and DRAM share the same SRAM, so this leaves more
# heap. Costs a little Wi-Fi throughput, which Matter does not need.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Security modes the Matter SDK never uses: it only sets the SSID and passphrase of the network
# (WPA/WPA2/WPA3 Personal), so no enterprise (802.1X/EAP) and no OWE. WPA3 SAE stays.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
# IPv6 addresses from the router advertisements (SLAAC): link-local + up to 5 SLAAC addresses, as in the
# esp-matter Wi-Fi examples
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# The SuperMini has no USB-UART chip: logs on the built-in USB-Serial-JTAG of the USB-C port (GPIO18/GPIO19).
# No Matter console (about 10 KB more heap, esp-matter RAM guide): turn CONFIG_ENABLE_CHIP_SHELL back on in
# menuconfig to debug.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ENABLE_CHIP_SHELL=n

# Matter. Own product ID 0x8001, never the 0x8000 of the ESP32-H2 firmware, so controllers and OTA images never mix
# them up (the SDK test DAC, PAI and Certification Declaration cover 0xFFF1/0x8001).
CONFIG_DEVICE_PRODUCT_ID=0x8001
# Root, occupancy sensor, Range, Radar resolution and Radar Bluetooth (Mode Select) endpoints. The chip temperature
# endpoint (CONFIG_PRESENCE_CHIP_TEMPERATURE, off by default) needs 6.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=5
# Manufacturer / Model / Serial number come from main/device_info.cpp
CONFIG_CUSTOM_DEVICE_INSTANCE_INFO_PROVIDER=y
# Bluetooth (GAP) name while waiting for commissioning when CONFIG_DEVICE_NAME_PREFIX is empty:
# "Presence-<discriminator>". By default the device name "Presence-<last 4 serial characters>" is used instead.
CONFIG_BLE_DEVICE_NAME_PREFIX="Presence-"
# Name and device type in commissionable discovery (DNS-SD "DN" and "DT"), shown by controllers before pairing.
# 263 = 0x0107 Occupancy Sensor.
CONFIG_CHIP_PROJECT_CONFIG="main/chip_project_config.h"
CONFIG_ENABLE_COMMISSIONABLE_DEVICE_TYPE=y
CONFIG_DEVICE_TYPE=263
# OTA Requestor, and matter_presence_sensor-ota.bin in the build dir: the app image with the Matter OTA header (VID/PID from
# the config, version = PROJECT_VER_NUMBER/PROJECT_VER), the file a controller (Home Assistant Matter Server) serves
CONFIG_ENABLE_OTA_REQUESTOR=y
CONFIG_CHIP_OTA_IMAGE_BUILD=y
# Matter event history: critical events (start-up, boot reason) are rare and there are no debug events; the info
# buffer (occupancy changes) keeps its default size
CONFIG_EVENT_LOGGING_CRIT_BUFFER_SIZE=1024
CONFIG_EVENT_LOGGING_DEBUG_BUFFER_SIZE=256

# Pins, LED and button: boards/<board>.defaults (tools/build.sh adds the file of the board).

# Empty room learning on every board: the ESP32 records the empty room for 120 s and sets every radar threshold
# from the highest energy and the average of its gate (README, "Học phòng trống")
CONFIG_LD2410_LEARN_PEAK=y
CONFIG_LD2410_LEARN_DURATION_SEC=120

# Matter clusters no endpoint of this device has: less flash. The device keeps 21 clusters: those of its endpoints
# (Access Control, Administrator Commissioning, Basic Information, Descriptor, General Commissioning, General
# Diagnostics, Group Key Management, Identify, Mode Select, Network Commissioning, Occupancy Sensing, Operational
# Credentials, OTA Software Update Provider/Requestor, Wi-Fi Network Diagnostics), plus Scenes (the Mode Select
# server of the SDK registers a scene handler), Binding, Groups, On/Off, Level Control and Color Control (code the
# SDK builds anyway). CONFIG_PRESENCE_CHIP_TEMPERATURE turns Temperature Measurement back on.
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIONS_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AIR_QUALITY_CLUSTER=n
CONFIG_SUPPORT_AMBIENT_CONTEXT_SENSING_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_BASIC_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_LAUNCHER_CLUSTER=n
CONFIG_SUPPORT_AUDIO_OUTPUT_CLUSTER=n
CONFIG_SUPPORT_BOOLEAN_STATE_CLUSTER=n
CONFIG_SUPPORT_BOOLEAN_STATE_CONFIGURATION_CLUSTER=n
CONFIG_SUPPORT_BRIDGED_DEVICE_BASIC_INFORMATION_CLUSTER=n
CONFIG_SUPPORT_CAMERA_AV_SETTINGS_USER_LEVEL_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_CAMERA_AV_STREAM_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_CARBON_DIOXIDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_CARBON_MONOXIDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_CHANNEL_CLUSTER=n
CONFIG_SUPPORT_CHIME_CLUSTER=n
CONFIG_SUPPORT_CLOSURE_CONTROL_CLUSTER=n
CONFIG_SUPPORT_CLOSURE_DIMENSION_CLUSTER=n
CONFIG_SUPPORT_COMMISSIONER_CONTROL_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_METERING_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_PRICE_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_TARIFF_CLUSTER=n
CONFIG_SUPPORT_CONTENT_APP_OBSERVER_CLUSTER=n
CONFIG_SUPPORT_CONTENT_CONTROL_CLUSTER=n
CONFIG_SUPPORT_CONTENT_LAUNCHER_CLUSTER=n
CONFIG_SUPPORT_DEVICE_ENERGY_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_DEVICE_ENERGY_MANAGEMENT_MODE_CLUSTER=n
CONFIG_SUPPORT_DIAGNOSTIC_LOGS_CLUSTER=n
CONFIG_SUPPORT_DISHWASHER_ALARM_CLUSTER=n
CONFIG_SUPPORT_DISHWASHER_MODE_CLUSTER=n
CONFIG_SUPPORT_DOOR_LOCK_CLUSTER=n
CONFIG_SUPPORT_ECOSYSTEM_INFORMATION_CLUSTER=n
CONFIG_SUPPORT_ELECTRICAL_ENERGY_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_ELECTRICAL_GRID_CONDITIONS_CLUSTER=n
CONFIG_SUPPORT_ELECTRICAL_POWER_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_ENERGY_EVSE_CLUSTER=n
CONFIG_SUPPORT_ENERGY_EVSE_MODE_CLUSTER=n
CONFIG_SUPPORT_ENERGY_PREFERENCE_CLUSTER=n
CONFIG_SUPPORT_ETHERNET_NETWORK_DIAGNOSTICS_CLUSTER=n
CONFIG_SUPPORT_FAN_CONTROL_CLUSTER=n
CONFIG_SUPPORT_FAULT_INJECTION_CLUSTER=n
CONFIG_SUPPORT_FIXED_LABEL_CLUSTER=n
CONFIG_SUPPORT_FLOW_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_FORMALDEHYDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n
CONFIG_SUPPORT_HEPA_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_HUMIDISTAT_CLUSTER=n
CONFIG_SUPPORT_ICD_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_ILLUMINANCE_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_JOINT_FABRIC_ADMINISTRATOR_CLUSTER=n
CONFIG_SUPPORT_JOINT_FABRIC_DATASTORE_CLUSTER=n
CONFIG_SUPPORT_KEYPAD_INPUT_CLUSTER=n
CONFIG_SUPPORT_LAUNDRY_DRYER_CONTROLS_CLUSTER=n
CONFIG_SUPPORT_LAUNDRY_WASHER_CONTROLS_CLUSTER=n
CONFIG_SUPPORT_LAUNDRY_WASHER_MODE_CLUSTER=n
CONFIG_SUPPORT_LOCALIZATION_CONFIGURATION_CLUSTER=n
CONFIG_SUPPORT_LOW_POWER_CLUSTER=n
CONFIG_SUPPORT_MEDIA_FILE_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_MEDIA_INPUT_CLUSTER=n
CONFIG_SUPPORT_MEDIA_PLAYBACK_CLUSTER=n
CONFIG_SUPPORT_MESSAGES_CLUSTER=n
CONFIG_SUPPORT_METER_IDENTIFICATION_CLUSTER=n
CONFIG_SUPPORT_MICROWAVE_OVEN_CONTROL_CLUSTER=n
CONFIG_SUPPORT_MICROWAVE_OVEN_MODE_CLUSTER=n
CONFIG_SUPPORT_NETWORK_IDENTITY_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_NITROGEN_DIOXIDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_OPERATIONAL_STATE_CLUSTER=n
CONFIG_SUPPORT_OPERATIONAL_STATE_OVEN_CLUSTER=n
CONFIG_SUPPORT_OPERATIONAL_STATE_RVC_CLUSTER=n
CONFIG_SUPPORT_OVEN_MODE_CLUSTER=n
CONFIG_SUPPORT_OZONE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_PM10_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_PM1_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_PM2_5_CONCENTRATION_MEASUREMENT_CLUSTER=n
