# ESP32-C3 SuperMini (flash 4 MB): HLK-LD2410C on UART1, radar TX -> GPIO3, radar RX -> GPIO4; on-board blue LED
# GPIO8, on when the pin is low; BOOT button GPIO9. Logs on the USB-C port (USB-Serial-JTAG).
CONFIG_BOARD_NAME="ESP32-C3 SuperMini"
CONFIG_LD2410_UART_RX_PIN=3
CONFIG_LD2410_UART_TX_PIN=4
CONFIG_STATUS_LED_TYPE_GPIO=y
CONFIG_STATUS_LED_GPIO=8
CONFIG_STATUS_LED_ACTIVE_HIGH=n
CONFIG_RESET_BUTTON_GPIO=9
