# ESP32-H2 mini (ESP32-H2 SuperMini, flash 4 MB): HLK-LD2410C on UART1, radar TX -> GPIO11, radar RX -> GPIO12;
# on-board WS2812 RGB LED on GPIO8; BOOT button GPIO9. Logs on UART0 (GPIO23 / GPIO24) and the USB-C port
# (USB-Serial-JTAG), the ESP-IDF defaults. The pins of the earlier ESP32-H2 firmware
# (ESP32-H2/matter-presence-ld2410-learning, README "Phần cứng").
CONFIG_BOARD_NAME="ESP32-H2 mini"
CONFIG_LD2410_UART_RX_PIN=11
CONFIG_LD2410_UART_TX_PIN=12
CONFIG_STATUS_LED_TYPE_WS2812=y
CONFIG_STATUS_LED_GPIO=8
CONFIG_RESET_BUTTON_GPIO=9
