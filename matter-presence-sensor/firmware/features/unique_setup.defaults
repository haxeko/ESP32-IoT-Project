# Optional feature: per-board random setup code instead of the SDK test code 20202021 / 3840 (README, "Mã ghép nối
# riêng cho từng bo"): tools/build.sh <board> unique_setup
# Each board generates its passcode, discriminator and SPAKE2+ verifier on first use and keeps them in the "fctry"
# partition (main/setup_code.cpp); the QR code is printed on the serial log while pairing is possible.
CONFIG_CUSTOM_COMMISSIONABLE_DATA_PROVIDER=y
CONFIG_UNIQUE_SETUP_CODE=y
CONFIG_ENABLE_TEST_SETUP_PARAMS=n
