# Exclude newly added clusters (Matter 1.5/1.6) that are not used by the light device type
CONFIG_SUPPORT_AMBIENT_CONTEXT_SENSING_CLUSTER=n
CONFIG_SUPPORT_CAMERA_AV_STREAM_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_MEDIA_FILE_MANAGEMENT_CLUSTER=n

# TC_RR_1_1 requires MaxGroupKeysPerFabric >= 4 (chip esp32 Kconfig defaults to 3)
CONFIG_MAX_GROUP_KEYS_PER_FABRIC=4
