CONFIG_IDF_TARGET="esp32s2"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ESP32-S2 has no Bluetooth: Wi-Fi is configured through the setup page
# (main/wifi_setup.cpp), then the device is commissioned on-network.
# The setup page needs the soft-AP; the Matter stack's own AP stays off.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ENABLE_WIFI_AP=n

# Log console on the native USB port (LOLIN S2 Mini and other boards without a
# USB-UART chip). For a board with a USB-UART chip on GPIO43/44 use
# CONFIG_ESP_CONSOLE_UART_DEFAULT=y instead.
CONFIG_ESP_CONSOLE_USB_CDC=y

# Use the PSRAM of ESP32-S2FN4R2 / WROVER modules when present, and keep
# running from internal RAM when it is not.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y

#enable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

#enable lwIP route hooks
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# Increase LwIP IPv6 address number to 6 (MAX_FABRIC + 1)
# unique local addresses for fabrics(MAX_FABRIC), a link local address(1)
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Enable OTA Requestor
CONFIG_ENABLE_OTA_REQUESTOR=y

# Manufacturer / Model / Serial number come from main/device_info.cpp
CONFIG_CUSTOM_DEVICE_INSTANCE_INFO_PROVIDER=y

# RAM optimizations (esp-matter docs/en/optimizations.rst). On ESP32-S2 the
# internal SRAM is shared between code (IRAM) and data, so moving the Wi-Fi
# hot paths out of IRAM directly increases the heap.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# Exclude unused clusters to optimize flash and memory usage
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AIR_QUALITY_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_BASIC_CLUSTER=n
