# Experimental ESP32 energy filter (README "Bộ lọc năng lượng trên ESP32"), as in the ESP32-C3-WROOM firmware of
# branch claude/c3-wroom-esp-filter. Applied after sdkconfig.defaults and sdkconfig.defaults.esp32h2:
#   idf.py -B build-espfilter -D IDF_TARGET=esp32h2 -D SDKCONFIG=sdkconfig.espfilter \
#     -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.espfilter" build
# The firmware version ends in "-espfilter" (presence.cmake) and the Model in Home Assistant (ProductName) differs,
# so this firmware is not mistaken for the stable one.
CONFIG_DEVICE_PRODUCT_NAME="Presence LD2410 ESP filter"
CONFIG_PRESENCE_ENERGY_FILTER=y
