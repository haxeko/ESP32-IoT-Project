menu "Device Information"

    config DEVICE_VENDOR_NAME
        string "Manufacturer (Basic Information VendorName)"
        default "Haxeko"

    config DEVICE_PRODUCT_NAME
        string "Model (Basic Information ProductName and ProductLabel)"
        default "Presence LD2410"
        help
            Home Assistant shows ProductLabel (else ProductName) as the model.

    config DEVICE_NAME_PREFIX
        string "Device name prefix, followed by the last 4 characters of the serial number"
        default "Presence-"
        help
            Device name: this prefix and the last 4 characters of the serial
            number (factory MAC in eFuse), e.g. "Presence-B2C3", so boards
            flashed with the same firmware get different names. Max 11
            characters.
            Written to Basic Information NodeLabel at boot when no label is
            stored yet (new board, after a factory reset); a label set from an
            app is kept. Home Assistant names the device after NodeLabel.
            Also the Bluetooth (GAP) name while waiting to be commissioned,
            seen only once connected: the Matter advertisement has no name.
            Empty: NodeLabel CONFIG_DEVICE_DISPLAY_NAME and the Bluetooth name
            "<BLE_DEVICE_NAME_PREFIX><discriminator>".

    config DEVICE_DISPLAY_NAME
        string "Name advertised before commissioning (DNS-SD)"
        default "Presence Sensor"
        help
            Name in commissionable node discovery (DNS-SD "DN"), the same for
            every board. Also the default NodeLabel when DEVICE_NAME_PREFIX is
            empty. Max 32 characters.

    config DEVICE_HARDWARE_VERSION_STRING
        string "Hardware (Basic Information HardwareVersionString)"
        default "ESP32C3-LD2410" if IDF_TARGET_ESP32C3
        default "ESP32H2-LD2410"
        help
            Shown as Hardware by controllers. Max 64 characters.

endmenu

menu "Presence Sensor Configuration"

    config LD2410_UART_RX_PIN
        int "UART RX pin (connect to LD2410 TX)"
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 27
        default 3 if IDF_TARGET_ESP32C3
        default 11
        help
            ESP32-H2: avoid the strapping pins (GPIO2, GPIO3, GPIO8, GPIO9,
            GPIO25), the flash pins (GPIO15-GPIO21) and the console UART pins
            (GPIO23, GPIO24).
            ESP32-C3: avoid the strapping pins (GPIO2, GPIO8, GPIO9), the
            flash pins (GPIO11-GPIO17) and the USB pins (GPIO18, GPIO19).

    config LD2410_UART_TX_PIN
        int "UART TX pin (connect to LD2410 RX)"
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 27
        default 4 if IDF_TARGET_ESP32C3
        default 12

    config PRESENCE_MAX_DISTANCE_CM
        int "Only count targets closer than (cm, 0 = use the radar's own gates)"
        range 0 800
        default 0
        help
            The LD2410 decides presence with its own per-gate sensitivity
            (default up to 6 m). A non-zero value additionally ignores targets
            further away than this distance.

    config PRESENCE_HOLD_TIME_SEC
        int "Default hold time (seconds)"
        range 1 300
        default 30
        help
            Occupancy Sensing HoldTime at first boot: how long the device keeps
            reporting "occupied" after the radar stops seeing anyone.
            Controllers (Home Assistant...) can change it later in 1-300 s;
            the new value is kept across reboots.

    config RADAR_TIMEOUT_SEC
        int "Report unoccupied when the radar sends nothing for (seconds)"
        range 1 300
        default 10

    choice STATUS_LED_TYPE
        prompt "Status LED"
        default STATUS_LED_TYPE_GPIO if IDF_TARGET_ESP32C3
        default STATUS_LED_TYPE_WS2812
        help
            Blinks blue while the device waits to be commissioned (pairing
            mode) and stays off otherwise. Blinks white when an app asks the
            device to identify itself. Empty room learning: cyan while there
            is time to leave the room, slow cyan blink while recording, then
            green for 10 s once the new thresholds are saved, or red for 10 s
            when the learning failed. A single-colour LED shows every colour
            as on.

        config STATUS_LED_TYPE_WS2812
            bool "Addressable WS2812 RGB LED (ESP32-H2-DevKitM-1: GPIO8)"

        config STATUS_LED_TYPE_GPIO
            bool "Single-colour LED on a GPIO (ESP32-C3 SuperMini: GPIO8)"

        config STATUS_LED_TYPE_NONE
            bool "None"
    endchoice

    config STATUS_LED_GPIO
        int "Status LED pin"
        depends on !STATUS_LED_TYPE_NONE
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 27
        default 8

    config STATUS_LED_ACTIVE_HIGH
        bool "Status LED is on when the pin is high"
        depends on STATUS_LED_TYPE_GPIO
        default n if IDF_TARGET_ESP32C3
        default y
        help
            The blue LED of the ESP32-C3 SuperMini is on when GPIO8 is low.

    config STATUS_LED_BRIGHTNESS
        int "WS2812 brightness (1-255)"
        depends on STATUS_LED_TYPE_WS2812
        range 1 255
        default 20

    config RESET_BUTTON_GPIO
        int "Button pin (-1 = none)"
        range -1 21 if IDF_TARGET_ESP32C3
        range -1 27
        default 9
        help
            Active-low push button, GPIO9 is the BOOT button (ESP32-H2 and
            ESP32-C3).
            Double click: pairing mode (opens the commissioning window for
            15 minutes, also to add the device to a second app).
            Triple click: empty room learning, as "Learning" in Home
            Assistant.
            Hold 5 seconds: factory reset (erases the Thread network or the
            Wi-Fi credentials, and the Matter pairing).

    config PRESENCE_WIFI_STAY_AWAKE
        bool "Keep Wi-Fi awake once BLE is released"
        depends on ENABLE_WIFI_STATION
        default y
        help
            Turns the Wi-Fi modem sleep (power save) off once BLE is released
            after commissioning, and at each boot of a commissioned device. In
            modem sleep the access point keeps the frames for the device until
            it wakes up for the next DTIM beacon, so the controllers'
            acknowledgements arrive late and Matter messages are sent again or
            time out. The device draws more current (it runs from USB anyway).
            While BLE commissions, the ESP-IDF default (modem sleep) is kept.

endmenu

menu "ESP32 Energy Filter (experimental)"

    config PRESENCE_ENERGY_FILTER
        bool "Confirm weak radar detections on the ESP32"
        depends on !PRESENCE_ESP_ENGINE
        default n
        help
            Keeps the radar in engineering mode (the energy of every gate in
            each report, about 10 reports per second) and compares the
            energies with the radar's own thresholds and Range. While the room
            is empty, an energy far enough above its threshold makes it
            occupied at once; weaker ones need several reports above a
            threshold in a row, so a single report slightly above a threshold
            (noise) no longer makes the room occupied. Once occupied, the
            radar decides alone, as without this option. The filter never
            reports someone the radar does not, and nothing is written to the
            radar. The log tells each decision (tag "app_main").
            Turned on by the variant sdkconfig.defaults.espfilter.

    config PRESENCE_ENERGY_FILTER_STRONG
        int "Energy above the threshold that confirms at once"
        depends on PRESENCE_ENERGY_FILTER
        range 1 100
        default 15
        help
            A report with a gate energy at least this much above the gate's
            threshold makes the empty room occupied at once (energies and
            thresholds 0-100).

    config PRESENCE_ENERGY_FILTER_FRAMES
        int "Reports in a row that confirm a weaker detection"
        depends on PRESENCE_ENERGY_FILTER
        range 2 20
        default 3
        help
            A weaker detection makes the empty room occupied once this many
            reports in a row (about 100 ms each) are above a threshold.

endmenu

menu "ESP32 Presence Engine (experimental)"

    config PRESENCE_ESP_ENGINE
        bool "The ESP32 decides presence from the energy of every gate"
        default n
        help
            Keeps the radar in engineering mode and decides presence on the
            ESP32 from the moving and still energy of every gate, with two
            thresholds per gate taken from the thresholds stored in the radar
            (the radar measures and stores them when the empty room is
            learned: "Learning" in Home Assistant, 3 clicks or LEARN_EMPTY,
            as with the stable firmware; or set them with HLKRadarTool).
            An empty room needs a strong signal (above the radar threshold)
            confirmed over several reports; once present, a lower hold
            threshold keeps it (people sitting still, small movements), and
            the room is empty after Hold time (Occupancy Sensing HoldTime)
            without it. The hold threshold stays above the noise of the empty
            room, recorded by the ESP32 while learning (stored in NVS). A
            silent radar is a sensor fault, never an empty room.
            Console commands and per-gate diagnostics on the ESP-IDF console.
            Same engine as the ESP32-C3-WROOM firmware 1.0.159 (branch
            claude/c3-wroom-esp-presence). Turned on by the variant
            sdkconfig.defaults.esppresence. README: "Bộ xử lý hiện diện trên
            ESP32".

    config PRESENCE_ENGINE_TRIGGER_REPORTS
        int "Strong reports that start presence"
        depends on PRESENCE_ESP_ENGINE
        range 1 16
        default 3
        help
            A gate (or its neighbours) must be above its radar threshold in
            this many of the last "report window" reports (filtered energy,
            about 100 ms each) for an empty room to become present.

    config PRESENCE_ENGINE_TRIGGER_WINDOW
        int "Report window of the strong signal"
        depends on PRESENCE_ESP_ENGINE
        range 1 16
        default 4

    config PRESENCE_ENGINE_HOLD_REPORTS
        int "Reports with a hold signal that keep presence"
        depends on PRESENCE_ESP_ENGINE
        range 1 16
        default 3
        help
            While present, a gate must reach its hold threshold in this many
            of the last "hold window" reports to restart the countdown.

    config PRESENCE_ENGINE_HOLD_WINDOW
        int "Report window of the hold signal"
        depends on PRESENCE_ESP_ENGINE
        range 1 16
        default 10

    config PRESENCE_ENGINE_HOLD_DROP_PERCENT
        int "Hold threshold: this share (%) below the radar threshold"
        depends on PRESENCE_ESP_ENGINE
        range 0 90
        default 40
        help
            Hold threshold of a gate = its radar threshold minus this share of
            it, at most "largest drop" below it, and never below the noise of
            the empty room recorded while learning + 2 (without a recording:
            the radar threshold itself). 0: hold at the radar threshold.

    config PRESENCE_ENGINE_HOLD_DROP_MAX
        int "Hold threshold: largest drop below the radar threshold"
        depends on PRESENCE_ESP_ENGINE
        range 0 50
        default 10

    config PRESENCE_ENGINE_NOISE_RECORD_SEC
        int "Noise of the empty room recorded by the ESP32 while learning (seconds)"
        depends on PRESENCE_ESP_ENGINE
        range 10 120
        default 30
        help
            Before the radar measures the empty room itself, the ESP32 records
            the energies of every gate for this long (the room must stay
            empty), so that the hold thresholds stay above the noise. A radar
            without its own measurement is recorded by the ESP32 for the
            learning time instead, which gives the noise too.

    config PRESENCE_ENGINE_DATA_TIMEOUT_MS
        int "Sensor fault after (ms) without a valid report with energies"
        depends on PRESENCE_ESP_ENGINE
        range 300 30000
        default 2000

    config PRESENCE_ENGINE_STATUS_LOG_SEC
        int "Log the status every (seconds, 0 = never)"
        depends on PRESENCE_ESP_ENGINE
        range 0 86400
        default 300

    config PRESENCE_ENGINE_CONSOLE
        bool "Console commands (LEARN_EMPTY, STATUS, DIAG...)"
        depends on PRESENCE_ESP_ENGINE
        default y
        help
            On the configured ESP-IDF console: USB-Serial-JTAG in
            sdkconfig.defaults.esppresence (the chip's own USB port, GPIO26 /
            GPIO27 on ESP32-H2, GPIO18 / GPIO19 on ESP32-C3); set the UART
            console in menuconfig for a board whose USB port goes through a
            USB-UART chip. With the Matter shell (CONFIG_ENABLE_CHIP_SHELL,
            on in the ESP32-H2 build) the commands are added to its console,
            next to "matter"; without it (ESP32-C3 build) they get a REPL of
            their own, about 5 KB of RAM.

endmenu

menu "Empty Room Learning"

    config LD2410_LEARN_DELAY_SEC
        int "Delay before recording (seconds)"
        range 0 120
        default 20
        help
            Time to leave the room after choosing "Learning" in Home Assistant
            or a triple click on the button (the LED is cyan meanwhile).
            The room must stay empty while the radar is recorded: the radar
            sees about 6 m, also through wooden doors and thin walls.

    config LD2410_LEARN_DURATION_SEC
        int "Recording time (seconds)"
        range 10 300
        default 60
        help
            How long the per-gate energy of the empty room is recorded (the
            LED blinks cyan slowly meanwhile). Long enough for a fan or an
            air conditioner that sweeps the room to pass a few times.

    config LD2410_LEARN_RADAR_AUTO
        bool "Let the radar measure the room itself when it can"
        default y
        help
            LD2410B/C radars with newer firmware measure the background noise
            of every gate themselves and set their moving and still
            thresholds (command 0x000B of the LD2410C serial protocol V1.09,
            the "Auto" button of the HLKRadarTool app; Hi-Link does not say
            from which radar firmware on). With this option the learning asks the radar
            first: it waits 10 s, then measures for the recording time. Hi-Link
            does not document how the thresholds are computed; they may be
            more sensitive than the factory defaults. A radar that refuses the
            command is learned by the ESP32 as below (noise percentile, margin,
            highest raise).

    config LD2410_LEARN_PERCENTILE
        int "Noise percentile (%)"
        range 50 100
        default 95
        help
            Noise of each gate = the energy that this share of the recorded
            reports stays at or below: the highest (100 - value) % of the
            reports are left out, so a short burst (someone walking past the
            door, a door closing) does not raise the threshold. At 95 % and
            60 s of recording, bursts of less than 3 s in total are left out,
            while something that moves more than 5 % of the time (fan,
            curtain) is learned. 100 takes the highest energy recorded, like
            older firmware.

    config LD2410_LEARN_MARGIN
        int "Margin above the recorded noise (energy 0-100)"
        range 0 50
        default 10
        help
            New threshold of each gate = recorded noise + this margin, never
            below the LD2410 factory default, at most the factory default +
            the highest raise below, and at most 100 (gate ignored).

    config LD2410_LEARN_MAX_RAISE
        int "Highest raise above the factory threshold (energy 0-100)"
        range 0 100
        default 30
        help
            A learned threshold is at most the factory default + this value,
            so a person or something moving during the recording cannot make
            a gate deaf. A gate limited this way is logged as a warning: what
            moved there may still be reported as presence. 100: no limit, a
            gate can be raised up to 100 (ignored).

endmenu

menu "Thread Diagnostics"
    depends on OPENTHREAD_ENABLED

    config THREAD_DIAG_LOG
        bool "Log Thread addresses and SRP state until commissioned"
        default y
        help
            Every 10 s, until commissioning completes, log the Thread role, IPv6 addresses
            (link-local / mesh-local / OMR), on-mesh prefixes from the Border Router and
            the SRP host/service registration state. Helps find why a phone cannot reach
            the device after BLE provisioning. Stops once the device is commissioned.

endmenu

menu "Identity Diagnostics and Setup Code"

    config IDENTITY_DIAG_PERIOD_SEC
        int "Identity / network / Matter diagnostics period (seconds, 0 = off)"
        range 0 86400
        default 300
        help
            Logs (tag "id_diag") at boot, at this period and on Thread or Wi-Fi,
            fabric and session events: reset reason, factory MAC, serial number,
            UniqueID, discriminator, Matter fabrics (index, node ID, fabric ID,
            compressed fabric ID, controller vendor), CASE sessions, subscriptions
            and NVS usage.
            ESP32-H2: IEEE EUI-64, Thread role, RLOC16, extended address, ML-EID,
            partition ID, leader, network name, Ext PAN ID, channel, neighbours,
            MLE counters, on-mesh prefixes, SRP server and registration state.
            ESP32-C3: Wi-Fi station MAC, SSID, BSSID, channel, RSSI, power save,
            IPv4 address and IPv6 addresses per kind.
            Never logs the setup passcode, private keys, the Thread network key
            or the Wi-Fi password.

    config IDENTITY_DIAG_SUBSCRIPTION_LOG
        bool "Log every subscription request, establishment and termination"
        default y
        help
            One line per subscription event with the fabric index, the controller
            node ID and the negotiated report intervals. Only observes: the
            subscriptions and their intervals are not changed.

    config PRINT_ONBOARDING_CODES
        bool "Log the QR code and manual pairing code when pairing is possible"
        default y
        help
            At boot when not commissioned, and when the button opens the pairing
            window. Development aid: the QR code contains the setup passcode, turn
            this off in production builds.

    config UNIQUE_SETUP_CODE
        bool "Per-board random setup code stored in flash"
        depends on CUSTOM_COMMISSIONABLE_DATA_PROVIDER
        default y
        help
            Enabled by sdkconfig.defaults.unique_setup (see README). Each board
            generates its own passcode, discriminator and SPAKE2+ salt on first use,
            computes the SPAKE2+ verifier and stores them in the partition below.
            Kept across reboots, OTA, factory reset and flashing the merged or app
            image; regenerated only after erase-flash.

    config UNIQUE_SETUP_CODE_PARTITION
        string "Flash partition for the per-board setup code"
        depends on UNIQUE_SETUP_CODE
        default "fctry"
        help
            NVS data partition, namespace "setup-code". "fctry" is otherwise unused
            by these builds and lies outside the area written by the merged image.

endmenu

menu "Memory Monitor"

    config MEM_MONITOR_PERIOD_SEC
        int "Memory log period (seconds, 0 = only at boot)"
        range 0 86400
        default 600
        help
            Logs the free heap (now, lowest since boot, largest block) and the
            unused stack of the main tasks at boot and then at this period,
            as a warning when a stack drops below 512 bytes, and once each
            time the lowest free heap reaches a new low below 16 KB (with the
            time window it happened in).

endmenu
