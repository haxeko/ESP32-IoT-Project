menu "Relay Configuration"

    config RELAY_GPIO
        int "Relay GPIO number"
        range 0 27
        default 4
        help
            GPIO that drives the relay module. Avoid the ESP32-H2 strapping pins
            (GPIO2, GPIO3, GPIO8, GPIO9, GPIO25) and the flash pins (GPIO15-GPIO21).

    config RELAY_ACTIVE_LEVEL
        int "Relay active level (1 = active-high, 0 = active-low)"
        range 0 1
        default 1
        help
            Level written to the relay GPIO to turn the relay ON.
            Many cheap optocoupled relay boards are active-low: set 0 for those.

    config STATUS_LED_ENABLE
        bool "Mirror relay state on the on-board WS2812 LED (GPIO8)"
        default y
        help
            ESP32-H2-DevKitM-1 has an addressable RGB LED on GPIO8.
            Disable on custom boards without it.

endmenu

menu "Thread Diagnostics"

    config THREAD_DIAG_LOG
        bool "Log Thread addresses and SRP state until commissioned"
        default y
        help
            Every 10 s, until commissioning completes, log the Thread role, IPv6 addresses
            (link-local / mesh-local / OMR), on-mesh prefixes from the Border Router and
            the SRP host/service registration state. Helps find why a phone cannot reach
            the device after BLE provisioning. Stops once the device is commissioned.

endmenu

menu "Device Identity"

    config DEVICE_VENDOR_NAME
        string "Manufacturer (Basic Information VendorName)"
        default "Haxeko"
        help
            Shown as Manufacturer in Apple Home. At most 32 characters.

    config DEVICE_PRODUCT_NAME
        string "Model (Basic Information ProductName)"
        default "Matter Thread Plug"
        help
            Shown as Model in Apple Home. At most 32 characters.

    choice SERIAL_NUMBER_SOURCE
        prompt "Serial number source"
        default SERIAL_NUMBER_FROM_GIT_COMMIT

        config SERIAL_NUMBER_FROM_GIT_COMMIT
            bool "Git commit of the firmware build"
            help
                Serial number = short git commit hash of the build (e.g. "a0fbc8c",
                "a0fbc8c-dirty" with uncommitted changes, "nogit" outside git).
                Every device flashed with the same build gets the same serial number.

        config SERIAL_NUMBER_FROM_MAC
            bool "Factory MAC address"
            help
                Serial number = factory eFuse MAC address (12 uppercase hex digits),
                unique per chip.
    endchoice

    config SERIAL_NUMBER_PREFIX
        string "Serial number prefix"
        default ""
        help
            Prepended to the serial number, e.g. prefix "RLY-" gives "RLY-a0fbc8c".
            Total length must stay within 32 characters.

endmenu
