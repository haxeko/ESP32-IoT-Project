CONFIG_SUPPORT_GROUPCAST_CLUSTER=n
CONFIG_SUPPORT_ELECTRICAL_ENERGY_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_ELECTRICAL_POWER_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_POWER_TOPOLOGY_CLUSTER=n

# Clusters this button never instantiates (as upstream esp-matter examples/light, plus Wi-Fi/Ethernet diagnostics
# on a Thread-only device). Keep OTA_SOFTWARE_UPDATE_PROVIDER (referenced by the OTA requestor path),
# LEVEL_CONTROL and COLOR_CONTROL (referenced by esp_matter_command.cpp). Kept on purpose: SWITCH, POWER_SOURCE,
# ICD_MANAGEMENT.
CONFIG_SUPPORT_ACTIONS_CLUSTER=n
