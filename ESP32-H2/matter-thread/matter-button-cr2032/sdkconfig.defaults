CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# BLE is only used for Matter commissioning (one CHIPoBLE peripheral link, no BLE pairing).
# Peripheral-only NimBLE, adapted from esp-matter docs "BLE Optimizations" (ESP32-H2: about -24 KB flash, +10 KB heap).
# CONFIG_BT_NIMBLE_MAX_BONDS from that list only exists with BT_NIMBLE_SECURITY_ENABLE=y, so it is left out.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_WHITELIST_SIZE=1
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=10
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=100
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=320
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=5
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=5
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=3
# NimBLE host INFO chatter (GAP/ATT); CHIPoBLE events are still logged by CHIP
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# CHIP shell (and the OpenThread CLI) only in the debug build: sdkconfig.defaults.debug.
# Release builds log Thread/SRP diagnostics instead (main/thread_diag.cpp)
CONFIG_ENABLE_CHIP_SHELL=n

# Only a few dynamic endpoints are needed
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2

# Vendor/product name, hardware version and MAC-based serial number (main/device_info.cpp)
CONFIG_CUSTOM_DEVICE_INSTANCE_INFO_PROVIDER=y

# Matter OTA requestor, with app rollback: a new image is confirmed after 60 s attached as a Thread child with its
# fabrics (main/app_main.cpp); an unconfirmed image is reverted by the bootloader at the next reset.
# The download is cancelled when the battery level is not OK (main/app_main.cpp, kOtaStateChanged)
CONFIG_ENABLE_OTA_REQUESTOR=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Also build a Matter OTA image (build/matter_button_h2-ota.bin) to serve from an OTA provider
CONFIG_CHIP_OTA_IMAGE_BUILD=y

# Unattended device: reboot if a task starves IDLE for more than 5 s instead of only logging
CONFIG_ESP_TASK_WDT_PANIC=y

# Matter SDK overrides (ICD observer pool)
CONFIG_CHIP_PROJECT_CONFIG="main/chip_project_config.h"

# ------------------------------------------------------------------------------------------------------------------
# Battery: Light-sleep with the digital peripherals and the flash powered down (ESP32-H2 datasheet: ~25 uA),
# as esp-matter examples/icd_app and ESP-IDF examples/openthread/ot_sleepy_device/light_sleep
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=y
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y
# (icd_app also sets CONFIG_ESP_PHY_MAC_BB_PD: it does not exist on ESP32-H2, no SOC_PM_SUPPORT_MAC_BB_PD; the radio
#  sleeps through CONFIG_IEEE802154_SLEEP_ENABLE / CONFIG_BT_LE_SLEEP_ENABLE below)
# Sleep entry/exit code in IRAM: shorter wake-ups (~2 KB IRAM)
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
# 1 ms tick: lower Light-sleep entry threshold
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_IEEE802154_SLEEP_ENABLE=y
# BLE (commissioning only) may sleep between events; the 32 MHz XTAL is its low power clock (no 32 kHz crystal)
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_LP_CLK_SRC_MAIN_XTAL=y
# BLE TX 0 dBm (default +9 dBm, 60 mA): the phone is next to the button during commissioning
CONFIG_BT_LE_DFT_TX_POWER_LEVEL_N0=y
# RTC slow clock from the internal 136 kHz RC: a sleepy end device polls, it needs no precise wake-up timing
CONFIG_RTC_CLK_SRC_INT_RC=y
# Brownout reset at ~2.94 V: the TPS63900 holds 3.3 V until the cell gives out; ESP32-H2 minimum is 3.0 V
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y
# Console on UART0 only (USB-Serial-JTAG has no Light-sleep retention)
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Every log line keeps the CPU awake ~87 us per character at 115200 baud: CHIP logs errors only
# (sdkconfig.defaults.debug: progress)
CONFIG_CHIP_LOG_DEFAULT_LEVEL_ERROR=y

# ------------------------------------------------------------------------------------------------------------------
# Matter ICD, Short Idle Time (works with every controller, Apple Home included):
#   slow poll 15 s (SIT maximum), fast poll 200 ms, report / keep-alive every hour (IdleModeDuration),
#   active 1 s after the idle period and after network activity.
# LIT (Check-In) instead: sdkconfig.defaults.lit
CONFIG_ENABLE_ICD_SERVER=y
CONFIG_ICD_SLOW_POLL_INTERVAL_MS=15000
CONFIG_ICD_FAST_POLL_INTERVAL_MS=200
CONFIG_ICD_IDLE_MODE_INTERVAL_SEC=3600
CONFIG_ICD_ACTIVE_MODE_INTERVAL_MS=1000
CONFIG_ICD_ACTIVE_MODE_THRESHOLD_MS=1000
# Check-In / User Active Mode Trigger only make sense with LIT
CONFIG_ENABLE_ICD_CIP=n
CONFIG_ENABLE_ICD_USER_ACTIVE_MODE_TRIGGER=n

# Flash: keep the assertion checks and the panic/backtrace, drop the expression/file/function strings
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
# Flash: IM PrettyPrint() only prints with CHIP detail logging, which is off
CONFIG_CHIP_CONFIG_IM_PRETTY_PRINT=n

# mbedTLS: Matter/Thread/BLE use only P-256, SHA-256, AES-CCM/CMAC
CONFIG_MBEDTLS_ERROR_STRINGS=n
# SHA384_C must go too: sha512.c is built if either is enabled
CONFIG_MBEDTLS_SHA384_C=n
CONFIG_MBEDTLS_SHA512_C=n
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
CONFIG_MBEDTLS_FS_IO=n

# Exclude unused clusters to optimize flash and memory usage
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AIR_QUALITY_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_BASIC_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_LAUNCHER_CLUSTER=n
