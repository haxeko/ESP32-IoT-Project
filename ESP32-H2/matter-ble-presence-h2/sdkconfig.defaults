# Two-chip version, ESP32-H2 Matter node. Applied after ESP32-C6/matter-ble-presence/sdkconfig.defaults (shared
# settings; its Wi-Fi settings are unknown symbols here, reported as NOTE lines by the build).
CONFIG_IDF_TARGET="esp32h2"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../ESP32-C6/matter-ble-presence/partitions.csv"
CONFIG_CHIP_PROJECT_CONFIG="../../ESP32-C6/matter-ble-presence/main/chip_project_config.h"

CONFIG_PRESENCE_ROLE_MATTER_UART=y

# UART link to the ESP32-C3: TX GPIO24 -> C3 GPIO21, RX GPIO23 <- C3 GPIO20 (the pins marked TX / RX on the
# ESP32-H2 SuperMini, i.e. UART0: the console moves to USB-Serial-JTAG only)
CONFIG_PRESENCE_LINK_UART_NUM=1
CONFIG_PRESENCE_LINK_TX_GPIO=24
CONFIG_PRESENCE_LINK_RX_GPIO=23
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Own product ID (0x8000 H2 LD2410, 0x8001 C3 LD2410, 0x8002 C6 Thread, 0x8003 C3 Wi-Fi versions)
CONFIG_DEVICE_PRODUCT_ID=0x8004

# BLE only for commissioning: the scanning is the ESP32-C3's, so NimBLE is released (and its RAM freed) once
# commissioned
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=y

# ---------------------------------------------------------------------------------------------------------------------
# Thread, as the ESP32-C6 version (MTD, set to Minimal End Device, mains powered); the radio serves Thread only
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_MTD=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
CONFIG_OPENTHREAD_CLI=y
CONFIG_LWIP_IPV6_AUTOCONFIG=n
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_ENABLE_EXTENDED_DISCOVERY=y
CONFIG_SUPPORT_THREAD_NETWORK_DIAGNOSTICS_CLUSTER=y

# Matter console on USB-Serial-JTAG: factory reset ("matter esp factoryreset"), diagnostics, OpenThread CLI
CONFIG_ENABLE_CHIP_SHELL=y
